#
# A consumer's view (PLAN.md section 7.3): each public header compiled alone, under the
# compiler's whole set and the library-only flags, at the build's standard. Each check
# includes its header twice, so a broken include guard is a redefinition error. The checks
# are an object library built with everything else; a header that does not stand alone
# fails the build.

file(GLOB_RECURSE _catenae_public_headers CONFIGURE_DEPENDS
     RELATIVE "${PROJECT_SOURCE_DIR}/include" "${PROJECT_SOURCE_DIR}/include/catenae/*.h")
list(SORT _catenae_public_headers)

set(_catenae_header_check_sources)
foreach(_header IN LISTS _catenae_public_headers)
    string(MAKE_C_IDENTIFIER "${_header}" _name)
    set(_source "${PROJECT_BINARY_DIR}/header_checks/${_name}.cpp")
    string(CONCAT _content "// Generated by cmake/catenae_header_checks.cmake: ${_header} alone, twice.\n"
                  "#include \"${_header}\"\n#include \"${_header}\"\n")
    file(CONFIGURE OUTPUT "${_source}" CONTENT "${_content}")
    list(APPEND _catenae_header_check_sources "${_source}")
endforeach()

add_library(catenae_header_checks OBJECT ${_catenae_header_check_sources})
target_include_directories(catenae_header_checks PRIVATE "${PROJECT_SOURCE_DIR}/include")
target_link_libraries(catenae_header_checks PRIVATE catenae_library_warnings catenae_no_exceptions)
