#ifndef CATENAE_CONFIG_H
#define CATENAE_CONFIG_H

/* The two check levels (D27). */
#define CATENAE_CHECKS_BOUNDARY 1
#define CATENAE_CHECKS_AUDIT 2

/* This build's level. */
#define CATENAE_CHECKS @CATENAE_CHECKS_VALUE@

/* Whether the host flushes subnormal results to zero on the threads that run catenae's
 * recursive stages: 1 (on, the default) or 0 (off). The library never writes the control
 * register; at the audit level a recursive stage reads it and checks it against this
 * (AOU-008, check::flush_to_zero). */
#define CATENAE_FLUSH_TO_ZERO @CATENAE_FLUSH_TO_ZERO_VALUE@

/* The FFT back ends (D28, PLAN.md section 7.2): none leaves that type's FFT out of the build. */
#define CATENAE_FFT_NONE 1
#define CATENAE_FFT_OWN 2
#define CATENAE_FFT_CMSIS 3
#define CATENAE_FFT_VDSP 4

/* This build's back end for each sample type. */
#define CATENAE_FFT_F32 @CATENAE_FFT_F32_VALUE@
#define CATENAE_FFT_F64 @CATENAE_FFT_F64_VALUE@
#define CATENAE_FFT_Q15 @CATENAE_FFT_Q15_VALUE@
#define CATENAE_FFT_Q31 @CATENAE_FFT_Q31_VALUE@

