#
# The reference (D46, PLAN.md section 11): Doxygen over the public headers, warnings as errors.
# Run from the repository root: doxygen docs/Doxyfile. Settings not named here are Doxygen's
# defaults. The site puts this output at /api/, beside the guide.
PROJECT_NAME           = catenae
PROJECT_BRIEF          = "Chainable Audio Transforms for Embedded, Native & Accelerated Environments"
PROJECT_LOGO           = assets/icon/png/catenae-icon-128.png
OUTPUT_DIRECTORY       = build-docs
INPUT                  = include docs/reference.md docs/contracts docs/assumptions.md docs/deviations.md
USE_MDFILE_AS_MAINPAGE = docs/reference.md
FILE_PATTERNS          = *.h *.md
RECURSIVE              = YES
STRIP_FROM_PATH        = include
STRIP_FROM_INC_PATH    = include
FULL_PATH_NAMES        = YES
MARKDOWN_SUPPORT       = YES
# The requirements page (PLAN.md section 11.2): each @req{ID} is an entry of the
# "Requirements" list, under its identifier. @req is an alias of \xrefitem, not a built-in.
ALIASES                = "req{1}=\xrefitem req \"Requirement\" \"Requirements\" <b>\1</b>"
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
# catenae's own internals: a name in a detail namespace is not the reference's.
EXCLUDE_SYMBOLS        = detail detail::* *::detail *::detail::*
# Every public member has a line, and every warning fails the run. A brief names its
# arguments, as a card's fields do (PLAN.md section 11.2, rule 2): no @param table is asked for.
# A macro is documented on the branch Doxygen's preprocessor takes, GCC's and Clang's.
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
SEARCHENGINE           = YES
HAVE_DOT               = NO
